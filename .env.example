# Gift Manager Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# REQUIRED IN PRODUCTION
# =============================================================================

# Django secret key - generate a new one for production!
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Email encryption key - generate a new one for production!
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=your-email-encryption-key-here

# Environment: development, testing, or production
DJANGO_ENV=development

# Database configuration
DB_NAME=gift_manager
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer  # Use 'require' in production

# =============================================================================
# EMAIL CONFIGURATION (Required for production)
# =============================================================================

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@gift-manager.com

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=.vercel.app,gift-manager.vercel.app,your-custom-domain.com

# CSRF trusted origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-custom-domain.com

# SSL redirect (set to false if behind a proxy that handles SSL)
SECURE_SSL_REDIRECT=true

# Admin emails for error notifications (format: Name:email@example.com;Name2:email2@example.com)
DJANGO_ADMINS=Admin:admin@example.com

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=WARNING

# =============================================================================
# OPTIONAL: REDIS CACHING
# =============================================================================

# Redis URL for caching and sessions
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# OPTIONAL: SENTRY ERROR TRACKING
# =============================================================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1
