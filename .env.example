# Gift Manager Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# REQUIRED IN PRODUCTION
# =============================================================================

# Django secret key - generate a new one for production!
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Email encryption key - generate a new one for production!
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=your-email-encryption-key-here

# Environment: development, testing, or production
DJANGO_ENV=development

# Database configuration
DB_NAME=gift_manager
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_HOST_PORT=5433  # Host port for Docker Compose's PostgreSQL service
DB_SSLMODE=disable  # Use 'require' for external production DBs

# =============================================================================
# EMAIL CONFIGURATION (Required for production)
# =============================================================================

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@gift-manager.com

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

# Comma-separated exact hostnames. Wildcards, schemes, ports, and paths are rejected.
ALLOWED_HOSTS=gift.example.com,www.gift.example.com

# CSRF trusted exact HTTPS origins matching ALLOWED_HOSTS (comma-separated)
CSRF_TRUSTED_ORIGINS=https://gift.example.com,https://www.gift.example.com

# Nginx production TLS/host configuration for docker-compose.prod.yml
NGINX_SERVER_NAME="gift.example.com www.gift.example.com"
NGINX_CANONICAL_HOST=gift.example.com
NGINX_SSL_DIR=./certs

# SSL redirect (set to false if behind a proxy that handles SSL)
SECURE_SSL_REDIRECT=true

# Admin emails for error notifications (format: Name:email@example.com;Name2:email2@example.com)
DJANGO_ADMINS=Admin:admin@example.com

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=WARNING

# =============================================================================
# OPTIONAL: REDIS CACHING
# =============================================================================

# Redis URL for caching and sessions
# REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change-this-redis-password

# =============================================================================
# OPTIONAL: BACKUP AND RESTORE
# =============================================================================

BACKUP_DIR=/var/backups/gift-manager
BACKUP_RETENTION_DAYS=30
# Prefer age public-key encryption for unattended backups.
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_AGE_IDENTITY_FILE=/run/secrets/backup-age-identity.txt
# Alternatives: BACKUP_GPG_RECIPIENT=ops@example.com or BACKUP_PASSPHRASE=...
# BACKUP_UPLOAD_CMD='rclone copy "$BACKUP_FILE" remote:gift-manager && rclone copy "$BACKUP_MANIFEST" remote:gift-manager'
# BACKUP_MONITOR_SUCCESS_URL=https://monitor.example.com/gift-manager-backup/success
# BACKUP_MONITOR_FAILURE_URL=https://monitor.example.com/gift-manager-backup/failure
MEDIA_BACKUP_ENABLED=false

# =============================================================================
# OPTIONAL: SENTRY ERROR TRACKING
# =============================================================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1
