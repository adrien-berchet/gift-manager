# Copy to /etc/gift-manager/backup.env and restrict permissions to root.

BACKUP_DIR=/var/backups/gift-manager
BACKUP_DB_MODE=compose
DB_NAME=gift_manager
DB_USER=gift_manager
DB_HOST=db
DB_PORT=5432

# Prefer age public-key encryption for unattended backups.
BACKUP_AGE_RECIPIENT=age1...
BACKUP_AGE_IDENTITY_FILE=/run/secrets/backup-age-identity.txt

# Optional upload and monitoring hooks.
# BACKUP_UPLOAD_CMD='rclone copy "$BACKUP_FILE" remote:gift-manager && rclone copy "$BACKUP_MANIFEST" remote:gift-manager'
# BACKUP_MONITOR_SUCCESS_URL=https://monitor.example.com/gift-manager-backup/success
# BACKUP_MONITOR_FAILURE_URL=https://monitor.example.com/gift-manager-backup/failure

MEDIA_ROOT=media
MEDIA_BACKUP_ENABLED=false
