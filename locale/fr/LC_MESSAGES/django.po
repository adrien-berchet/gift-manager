msgid "— Choose collaborator —"
msgstr "— Choisir un collaborateur —"

msgid "e.g. Uncle Bob"
msgstr "ex. Tonton Bob"

msgid "Choose a collaborator or enter an external name, not both."
msgstr "Choisissez un collaborateur ou saisissez un nom externe, pas les deux."

msgid "Choose a collaborator or enter an external name."
msgstr "Choisissez un collaborateur ou saisissez un nom externe."

msgid "The recipient cannot be a contributor to their own gift."
msgstr "Le destinataire ne peut pas contribuer à son propre cadeau."

msgid "This user is already a contributor."
msgstr "Cet utilisateur est déjà contributeur."

msgid "Invalid split mode."
msgstr "Mode de répartition invalide."

msgid "Cannot disable a group gift with recorded payments."
msgstr "Impossible de désactiver un cadeau commun avec des paiements enregistrés."

msgid "Group gift is not enabled on this plan."
msgstr "Le cadeau commun n'est pas activé sur ce projet."

msgid "User must have access to the gift plan."
msgstr "L'utilisateur doit avoir accès au projet de cadeau."

msgid "User cannot access this surprise gift plan."
msgstr "L'utilisateur ne peut pas accéder à ce projet de cadeau surprise."

msgid "Contributor name must be between 1 and 150 characters."
msgstr "Le nom du contributeur doit comporter entre 1 et 150 caractères."

msgid "Cannot remove the designated buyer from contributors."
msgstr "Impossible de retirer l'acheteur désigné des contributeurs."

msgid "Cannot remove a contributor with a recorded payment; unmark payment first."
msgstr "Impossible de retirer un contributeur avec un paiement enregistré ; annulez d'abord le paiement."

msgid "Only editors, owners, or the buyer can update payment status."
msgstr "Seuls les éditeurs, propriétaires ou l'acheteur peuvent mettre à jour le statut du paiement."

msgid "The buyer's share is settled by definition."
msgstr "La part de l'acheteur est réglée par définition."

msgid "Cannot mark a zero-amount share as paid."
msgstr "Impossible de marquer une part de montant nul comme payée."

msgid "Share amounts can only be updated in custom split mode."
msgstr "Les montants des parts ne peuvent être modifiés qu'en mode de répartition personnalisée."

msgid "Cannot update amount for a contribution that is already marked as paid."
msgstr "Impossible de modifier le montant d'une contribution déjà marquée comme payée."

msgid "Enter a valid amount."
msgstr "Saisissez un montant valide."

msgid "Amount must be a non-negative finite value under 100,000,000."
msgstr "Le montant doit être une valeur finie positive ou nulle inférieure à 100 000 000."

msgid "Group gift"
msgstr "Cadeau commun"

msgid "Whether this gift plan is funded collaboratively by multiple contributors."
msgstr "Indique si ce projet de cadeau est financé collectivement par plusieurs contributeurs."

msgid "How the total gift cost is divided among contributors."
msgstr "Façon dont le coût total du cadeau est réparti entre les contributeurs."

msgid "Registered user participating in this group gift."
msgstr "Utilisateur inscrit participant à ce cadeau commun."

msgid "Snapshot name of the contributor or external contributor label."
msgstr "Instantané du nom du contributeur ou libellé de contributeur externe."

msgid "Share amount"
msgstr "Montant de la part"

msgid "Stored share amount in custom mode, or frozen paid amount in equal mode."
msgstr "Montant de la part stocké en mode personnalisé, ou montant payé figé en mode égal."

msgid "Whether this contributor has paid their share to the buyer."
msgstr "Indique si ce contributeur a réglé sa part à l'acheteur."

msgid "When this share was marked as paid."
msgstr "Date et heure auxquelles cette part a été marquée comme payée."

msgid "A contributor name is required."
msgstr "Un nom de contributeur est obligatoire."

msgid "Add Contributor"
msgstr "Ajouter un contributeur"

msgid "Amount"
msgstr "Montant"

msgid "Are you sure you want to disable the group gift for this plan?"
msgstr "Êtes-vous sûr de vouloir désactiver le cadeau commun pour ce projet ?"

