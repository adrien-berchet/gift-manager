msgstr "Supprimer le contributeur"

msgid "Save amount"
msgstr "Enregistrer le montant"

msgid "Switch to custom amounts"
msgstr "Passer aux montants personnalisés"

msgid "Switch to equal split"
msgstr "Passer aux parts égales"

